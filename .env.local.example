# Supabase — add your project credentials from
# Supabase Dashboard → Project Settings → API
# The app automatically switches from DEMO MODE to real Supabase when set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privileged account operations run in Supabase Edge Functions.
# Keep their service-role key and SUPERADMIN_SETUP_CODE in Supabase Function
# secrets, never in the browser or Vercel frontend environment.